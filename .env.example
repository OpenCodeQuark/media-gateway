PORT=5012
NODE_ENV=development
HOST=0.0.0.0
TRUST_PROXY=false

LOG_LEVEL=info

RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120
MAX_CONCURRENT_STREAMS=100

MEDIA_CACHE_CONTROL=public, max-age=3600
METADATA_CACHE_TTL_MS=300000
METADATA_CACHE_MAX_ENTRIES=1000

# Idle timeout is between chunks — not total stream duration.
UPSTREAM_CONNECT_TIMEOUT_MS=10000
UPSTREAM_METADATA_TIMEOUT_MS=10000
UPSTREAM_IDLE_TIMEOUT_MS=60000

# Optional — public/shared Drive files work without these.
GOOGLE_API_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

SHUTDOWN_TIMEOUT_MS=30000
