<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= title %> — Media Gateway</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = { darkMode: 'media' };
  </script>
</head>
<body class="min-h-screen bg-stone-50 text-stone-900 antialiased dark:bg-stone-950 dark:text-stone-100">
  <main class="mx-auto flex min-h-screen w-full max-w-xl flex-col justify-center px-5 py-16">
    <p class="text-sm font-medium text-stone-500 dark:text-stone-400">Media Gateway</p>
    <p class="mt-6 font-mono text-sm text-teal-800 dark:text-teal-300"><%= status %></p>
    <h1 class="mt-2 text-3xl font-semibold tracking-tight"><%= title %></h1>
    <p class="mt-3 text-base leading-relaxed text-stone-600 dark:text-stone-400"><%= message %></p>
    <p class="mt-8">
      <a href="/" class="text-sm font-medium text-teal-800 underline decoration-teal-800/30 underline-offset-4 hover:decoration-teal-800 focus:outline-none focus:ring-2 focus:ring-teal-700 dark:text-teal-300 dark:decoration-teal-300/30">Back to Media Gateway</a>
    </p>
  </main>
</body>
</html>
