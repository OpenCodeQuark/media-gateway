<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Media Gateway - Comic Edition!</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Bangers&family=Comic+Neue:wght@400;700&display=swap" rel="stylesheet">
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = { 
      theme: {
        extend: {
          fontFamily: {
            sans: ['"Comic Neue"', 'cursive'],
            heading: ['Bangers', 'cursive']
          }
        }
      }
    };
  </script>
  <style>
    .comic-shadow {
      box-shadow: 6px 6px 0px 0px rgba(0,0,0,1);
    }
    .comic-shadow:active {
      box-shadow: 2px 2px 0px 0px rgba(0,0,0,1);
      transform: translate(4px, 4px);
    }
    .comic-shadow-sm {
      box-shadow: 4px 4px 0px 0px rgba(0,0,0,1);
    }
    /* Polka dot background for comic feel */
    .polka-bg {
      background-image: radial-gradient(#000 1.5px, transparent 1.5px);
      background-size: 24px 24px;
    }
  </style>
</head>
<body class="min-h-screen bg-yellow-300 polka-bg text-black font-sans antialiased flex flex-col items-center justify-center py-12 px-4 sm:px-6 lg:px-8">
  
  <main class="w-full max-w-3xl space-y-12 relative z-10">
    <!-- Header -->
    <div class="text-center bg-white border-4 border-black p-6 rounded-2xl comic-shadow transform -rotate-2 mx-auto max-w-md">
      <h1 class="text-5xl tracking-wide text-black font-heading uppercase text-shadow">
        Media Gateway!
      </h1>
      <p class="mt-2 text-xl font-bold text-gray-800">
        Stream Google Drive media through a direct URL
      </p>
    </div>

    <!-- Main Card -->
    <div class="bg-white border-4 border-black rounded-3xl comic-shadow p-6 sm:p-10 transform rotate-1">
      <form id="form" class="space-y-6">
        <div>
          <label for="input" class="block text-2xl font-bold text-black mb-2 uppercase font-heading tracking-widest">Google Drive URL or File ID</label>
          <input
            id="input"
            name="input"
            type="text"
            autocomplete="off"
            spellcheck="false"
            placeholder="Paste Google Drive link or file ID"
            class="block w-full rounded-xl border-4 border-black bg-cyan-100 py-3 px-4 text-black comic-shadow-sm focus:outline-none focus:bg-white focus:-translate-y-1 text-xl font-bold placeholder-gray-600 transition-all"
          >
        </div>
        
        <div class="flex flex-col sm:flex-row gap-4">
          <button id="generate" type="submit" class="flex-1 rounded-xl bg-red-400 border-4 border-black px-4 py-3 text-3xl uppercase tracking-widest font-heading text-black comic-shadow transition-all">
            Generate Direct Link
          </button>
          <button id="validate" type="button" class="sm:w-48 rounded-xl bg-green-400 border-4 border-black px-4 py-3 text-3xl uppercase tracking-widest font-heading text-black comic-shadow transition-all">
            Validate
          </button>
        </div>
      </form>

      <!-- Status & Results -->
      <div id="status-container" class="mt-6 min-h-[2.5rem]">
        <p id="status" class="text-2xl font-bold uppercase tracking-wider"></p>
      </div>

      <section class="mt-6 hidden rounded-xl bg-purple-300 border-4 border-black p-4 comic-shadow-sm transform -rotate-1" id="result" aria-live="polite">
        <h2 class="text-2xl font-heading text-black uppercase tracking-widest mb-2">Direct URL:</h2>
        <div class="flex items-center gap-3 bg-white border-4 border-black rounded-lg p-2">
          <p id="url" class="flex-1 truncate font-mono text-lg font-bold text-black"></p>
          <button id="copy" type="button" aria-label="Copy direct link" class="shrink-0 rounded-lg bg-yellow-400 border-4 border-black p-2 text-black comic-shadow transition-all relative group">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" class="h-6 w-6" aria-hidden="true"><rect x="9" y="9" width="11" height="11" rx="2"></rect><path d="M5 15V5a2 2 0 0 1 2-2h10"></path></svg>
            <span id="copied" class="absolute -top-12 -right-4 rounded-lg bg-black border-4 border-white px-3 py-1 text-xl font-heading tracking-widest text-white opacity-0 transition-opacity pointer-events-none transform rotate-3">BAM! Copied!</span>
          </button>
        </div>
      </section>
    </div>

    <!-- Features -->
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-6 pt-2">
      <div class="bg-blue-300 border-4 border-black p-5 rounded-2xl comic-shadow transform -rotate-3 hover:-translate-y-2 transition-transform">
        <h3 class="text-3xl font-heading uppercase text-black tracking-wide">Direct Stream 🎬</h3>
        <p class="mt-2 text-xl font-bold text-gray-900 leading-tight">Watch files instantly! No waiting around!</p>
      </div>
      <div class="bg-pink-300 border-4 border-black p-5 rounded-2xl comic-shadow transform rotate-2 hover:-translate-y-2 transition-transform">
        <h3 class="text-3xl font-heading uppercase text-black tracking-wide">Range Support 🚀</h3>
        <p class="mt-2 text-xl font-bold text-gray-900 leading-tight">Skip forward like a time traveler!</p>
      </div>
      <div class="bg-orange-300 border-4 border-black p-5 rounded-2xl comic-shadow transform -rotate-2 hover:-translate-y-2 transition-transform">
        <h3 class="text-3xl font-heading uppercase text-black tracking-wide">Super Secure 🛡️</h3>
        <p class="mt-2 text-xl font-bold text-gray-900 leading-tight">Your streams are safe from villains!</p>
      </div>
    </div>
  </main>

  <script>
    const input = document.getElementById('input');
    const generateBtn = document.getElementById('generate');
    const validateBtn = document.getElementById('validate');
    const copyBtn = document.getElementById('copy');
    const copiedEl = document.getElementById('copied');
    const result = document.getElementById('result');
    const urlEl = document.getElementById('url');
    const statusEl = document.getElementById('status');
    let currentUrl = '';
    let copiedTimer;

    function setStatus(message, ok) {
      statusEl.textContent = message || '';
      statusEl.className = 'text-2xl font-bold uppercase tracking-wider ' + (ok === true ? 'text-green-700' : ok === false ? 'text-red-600' : 'text-blue-700');
    }

    function showUrl(url) {
      currentUrl = url;
      urlEl.textContent = url;
      result.classList.toggle('hidden', !url);
      copyBtn.disabled = !url;
    }

    async function resolveInput() {
      const value = input.value.trim();
      if (!value) throw new Error('Enter a Google Drive link or file ID.');
      const res = await fetch('/api/resolve?input=' + encodeURIComponent(value));
      const data = await res.json();
      if (!res.ok || !data.success) throw new Error((data && data.error && data.error.message) || 'Could not resolve that input.');
      return data;
    }

    document.getElementById('form').addEventListener('submit', async (event) => {
      event.preventDefault();
      setStatus('Resolving…');
      generateBtn.disabled = true;
      try {
        const data = await resolveInput();
        showUrl(window.location.origin + '/media/' + encodeURIComponent(data.id));
        setStatus('');
      } catch (err) {
        showUrl('');
        setStatus(err.message || 'Failed to generate link.', false);
      } finally {
        generateBtn.disabled = false;
      }
    });

    validateBtn.addEventListener('click', async () => {
      setStatus('Validating…');
      validateBtn.disabled = true;
      try {
        const value = input.value.trim();
        if (!value) throw new Error('Enter a Google Drive link or file ID.');
        const res = await fetch('/api/validate?input=' + encodeURIComponent(value));
        const data = await res.json();
        if (!res.ok || !data.success) throw new Error((data && data.error && data.error.message) || 'Validation failed.');
        showUrl(window.location.origin + '/media/' + encodeURIComponent(data.id));
        const bytes = Number(data.size);
        const sizeLabel = Number.isFinite(bytes) && bytes > 0
          ? (Math.round((bytes / (1024 * 1024)) * 10) / 10) + ' MiB'
          : 'unknown size';
        const name = data.name ? data.name + ' — ' : '';
        setStatus('Valid — ' + name + (data.mimeType || 'unknown type') + ', ' + sizeLabel + '.', true);
      } catch (err) {
        setStatus(err.message || 'Validation failed.', false);
      } finally {
        validateBtn.disabled = false;
      }
    });

    async function copyText(text) {
      try {
        await navigator.clipboard.writeText(text);
        return true;
      } catch {
        const area = document.createElement('textarea');
        area.value = text;
        area.setAttribute('readonly', '');
        area.className = 'fixed left-0 top-0 h-px w-px opacity-0';
        document.body.appendChild(area);
        area.select();
        let ok = false;
        try { ok = document.execCommand('copy'); } catch { ok = false; }
        area.remove();
        return ok;
      }
    }

    function showCopied() {
      copiedEl.classList.remove('opacity-0');
      copiedEl.classList.add('opacity-100');
      clearTimeout(copiedTimer);
      copiedTimer = setTimeout(() => {
        copiedEl.classList.add('opacity-0');
        copiedEl.classList.remove('opacity-100');
      }, 1500);
    }

    copyBtn.addEventListener('click', async () => {
      if (!currentUrl) return;
      if (await copyText(currentUrl)) showCopied();
      else setStatus('Could not copy automatically. Select and copy the URL.', false);
    });
  </script>
</body>
</html>
