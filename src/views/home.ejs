<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Media Gateway</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = { darkMode: 'media' };
  </script>
</head>
<body class="min-h-screen bg-white text-neutral-900 antialiased dark:bg-neutral-950 dark:text-neutral-100">
  <main class="mx-auto flex min-h-screen w-full max-w-lg flex-col justify-center px-6 py-20">
    <h1 class="text-3xl font-semibold tracking-tight sm:text-4xl">Media Gateway</h1>
    <p class="mt-3 text-base leading-relaxed text-neutral-600 dark:text-neutral-400">
      Stream Google Drive media through a direct URL.
    </p>

    <form class="mt-10" id="form">
      <label class="sr-only" for="input">Google Drive link or file ID</label>
      <input
        id="input"
        name="input"
        type="text"
        autocomplete="off"
        spellcheck="false"
        placeholder="Paste Google Drive link or file ID"
        class="w-full rounded-md border border-neutral-300 bg-white px-3 py-2.5 text-base outline-none ring-neutral-900 placeholder:text-neutral-400 focus:ring-2 dark:border-neutral-700 dark:bg-neutral-950 dark:ring-neutral-100"
      >
      <div class="mt-4 flex items-center gap-5">
        <button id="generate" type="submit" class="rounded-md bg-neutral-900 px-3.5 py-2 text-sm font-medium text-white hover:bg-neutral-800 focus:outline-none focus:ring-2 focus:ring-neutral-900 focus:ring-offset-2 dark:bg-neutral-100 dark:text-neutral-900 dark:hover:bg-white dark:focus:ring-neutral-100 dark:focus:ring-offset-neutral-950">
          Generate Direct Link
        </button>
        <button id="validate" type="button" class="text-sm text-neutral-500 underline-offset-4 hover:text-neutral-900 hover:underline focus:outline-none focus:ring-2 focus:ring-neutral-900 dark:hover:text-neutral-100 dark:focus:ring-neutral-100">
          Validate
        </button>
      </div>
    </form>

    <section class="mt-10 hidden" id="result" aria-live="polite">
      <h2 class="text-sm font-medium text-neutral-500 dark:text-neutral-400">Direct link</h2>
      <div class="mt-2 flex items-start gap-2">
        <p id="url" class="min-w-0 flex-1 break-all font-mono text-sm leading-6"></p>
        <button id="copy" type="button" aria-label="Copy direct link" class="mt-0.5 inline-flex h-7 w-7 shrink-0 items-center justify-center rounded-md text-neutral-500 hover:bg-neutral-100 hover:text-neutral-900 focus:outline-none focus:ring-2 focus:ring-neutral-900 dark:hover:bg-neutral-800 dark:hover:text-neutral-100 dark:focus:ring-neutral-100">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4" aria-hidden="true">
            <rect x="9" y="9" width="11" height="11" rx="2"></rect>
            <path d="M5 15V5a2 2 0 0 1 2-2h10"></path>
          </svg>
        </button>
        <span id="copied" class="sr-only" role="status"></span>
      </div>
    </section>
    <p id="status" class="mt-4 min-h-6 text-sm" role="status"></p>
  </main>
  <script>
    const input = document.getElementById('input');
    const generateBtn = document.getElementById('generate');
    const validateBtn = document.getElementById('validate');
    const copyBtn = document.getElementById('copy');
    const copiedEl = document.getElementById('copied');
    const result = document.getElementById('result');
    const urlEl = document.getElementById('url');
    const statusEl = document.getElementById('status');
    let currentUrl = '';
    let copiedTimer;

    function setStatus(message, ok) {
      statusEl.textContent = message || '';
      statusEl.className = 'mt-4 min-h-6 text-sm ' + (ok === true ? 'text-neutral-800 dark:text-neutral-200' : ok === false ? 'text-red-700 dark:text-red-300' : 'text-neutral-500 dark:text-neutral-400');
    }

    function showUrl(url) {
      currentUrl = url;
      urlEl.textContent = url;
      result.classList.toggle('hidden', !url);
      copyBtn.disabled = !url;
    }

    async function resolveInput() {
      const value = input.value.trim();
      if (!value) throw new Error('Enter a Google Drive link or file ID.');
      const res = await fetch('/api/resolve?input=' + encodeURIComponent(value));
      const data = await res.json();
      if (!res.ok || !data.success) throw new Error((data && data.error && data.error.message) || 'Could not resolve that input.');
      return data;
    }

    document.getElementById('form').addEventListener('submit', async (event) => {
      event.preventDefault();
      setStatus('Resolving…');
      generateBtn.disabled = true;
      try {
        const data = await resolveInput();
        showUrl(window.location.origin + '/media/' + encodeURIComponent(data.id));
        setStatus('');
      } catch (err) {
        showUrl('');
        setStatus(err.message || 'Failed to generate link.', false);
      } finally {
        generateBtn.disabled = false;
      }
    });

    validateBtn.addEventListener('click', async () => {
      setStatus('Validating…');
      validateBtn.disabled = true;
      try {
        const value = input.value.trim();
        if (!value) throw new Error('Enter a Google Drive link or file ID.');
        const res = await fetch('/api/validate?input=' + encodeURIComponent(value));
        const data = await res.json();
        if (!res.ok || !data.success) throw new Error((data && data.error && data.error.message) || 'Validation failed.');
        showUrl(window.location.origin + '/media/' + encodeURIComponent(data.id));
        const bytes = Number(data.size);
        const sizeLabel = Number.isFinite(bytes) && bytes > 0
          ? (Math.round((bytes / (1024 * 1024)) * 10) / 10) + ' MiB'
          : 'unknown size';
        const name = data.name ? data.name + ' — ' : '';
        setStatus('Valid — ' + name + (data.mimeType || 'unknown type') + ', ' + sizeLabel + '.', true);
      } catch (err) {
        setStatus(err.message || 'Validation failed.', false);
      } finally {
        validateBtn.disabled = false;
      }
    });

    async function copyText(text) {
      try {
        await navigator.clipboard.writeText(text);
        return true;
      } catch {
        const area = document.createElement('textarea');
        area.value = text;
        area.setAttribute('readonly', '');
        area.className = 'fixed left-0 top-0 h-px w-px opacity-0';
        document.body.appendChild(area);
        area.select();
        let ok = false;
        try { ok = document.execCommand('copy'); } catch { ok = false; }
        area.remove();
        return ok;
      }
    }

    function showCopied() {
      copiedEl.textContent = 'Copied';
      copiedEl.className = 'pt-1 text-xs text-neutral-500 dark:text-neutral-400';
      clearTimeout(copiedTimer);
      copiedTimer = setTimeout(() => {
        copiedEl.textContent = '';
        copiedEl.className = 'sr-only';
      }, 1500);
    }

    copyBtn.addEventListener('click', async () => {
      if (!currentUrl) return;
      if (await copyText(currentUrl)) showCopied();
      else setStatus('Could not copy automatically. Select and copy the URL.', false);
    });
  </script>
</body>
</html>
